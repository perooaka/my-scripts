local ESPObjects = {}

local function RemoveESP(player)
    local data = ESPObjects[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    if data.Tracer then
        data.Tracer:Destroy()
    end

    ESPObjects[player] = nil
end

local function CreateESP(player)
    if player == LocalPlayer then
        return
    end

    if not player.Character then
        return
    end

    RemoveESP(player)

    local character = player.Character
    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    local data = {}

    -- Highlight
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "DeltaESP"
    Highlight.Adornee = character
    Highlight.FillColor = CONFIG.ESPColor
    Highlight.OutlineColor = CONFIG.ESPColor
    Highlight.FillTransparency = 0.75
    Highlight.OutlineTransparency = 0
    Highlight.Enabled = CONFIG.ESP
    Highlight.Parent = character

    data.Highlight = Highlight

    -- Name + distance
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "DeltaESPInfo"
    Billboard.Adornee = head
    Billboard.Size = UDim2.fromOffset(180, 45)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Enabled = CONFIG.ESPName
    Billboard.Parent = head

    local Text = Instance.new("TextLabel")
    Text.Size = UDim2.fromScale(1, 1)
    Text.BackgroundTransparency = 1
    Text.Font = Enum.Font.GothamBold
    Text.TextColor3 = CONFIG.ESPColor
    Text.TextStrokeTransparency = 0.4
    Text.TextSize = 13
    Text.Text = player.Name
    Text.Parent = Billboard

    data.Billboard = Billboard
    data.Text = Text

    -- Tracer
    local Tracer = Instance.new("Frame")
    Tracer.Name = "Tracer_" .. player.Name
    Tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    Tracer.BackgroundColor3 = CONFIG.ESPColor
    Tracer.BorderSizePixel = 0
    Tracer.Size = UDim2.fromOffset(2, 0)
    Tracer.Visible = CONFIG.Tracers
    Tracer.Parent = ScreenGui

    data.Tracer = Tracer

    ESPObjects[player] = data
end

local function RefreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateESP(player)
        end
    end
end

local function UpdateESP()
    local myRoot = GetRoot()

    for player, data in pairs(ESPObjects) do
        if not player.Parent then
            RemoveESP(player)
            continue
        end

        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local head = character and character:FindFirstChild("Head")

        if not root or not head then
            continue
        end

        if data.Highlight then
            data.Highlight.Enabled = CONFIG.ESP
            data.Highlight.FillColor = CONFIG.ESPColor
            data.Highlight.OutlineColor = CONFIG.ESPColor
        end

        if data.Billboard then
            data.Billboard.Enabled = CONFIG.ESPName
        end

        if data.Text then
            data.Text.TextColor3 = CONFIG.ESPColor

            if myRoot then
                local distance = (myRoot.Position - root.Position).Magnitude
                data.Text.Text = string.format(
                    "%s\n%d studs",
                    player.DisplayName,
                    distance
                )
            end
        end

        if data.Tracer then
            data.Tracer.Visible = CONFIG.Tracers

            local viewportPoint, onScreen =
                Camera:WorldToViewportPoint(root.Position)

            if onScreen then
                local startPosition = Vector2.new(
                    Camera.ViewportSize.X / 2,
                    Camera.ViewportSize.Y
                )

                local endPosition = Vector2.new(
                    viewportPoint.X,
                    viewportPoint.Y
                )

                local difference = endPosition - startPosition
                local length = difference.Magnitude

                data.Tracer.Position = UDim2.fromOffset(
                    (startPosition.X + endPosition.X) / 2,
                    (startPosition.Y + endPosition.Y) / 2
                )

                data.Tracer.Size = UDim2.fromOffset(2, length)

                data.Tracer.Rotation =
                    math.deg(math.atan2(difference.Y, difference.X)) + 90

                data.Tracer.BackgroundColor3 = CONFIG.ESPColor
            else
                data.Tracer.Visible = false
            end
        end
    end
end

