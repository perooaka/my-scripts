local function Toggle(parent, text, callback)
    local B = Button(parent, text .. ": OFF")
    local state = false

    B.MouseButton1Click:Connect(function()
        state = not state

        B.Text = text .. ": " .. (state and "ON" or "OFF")
        B.BackgroundColor3 = state
            and Color3.fromRGB(35, 75, 45)
            or Color3.fromRGB(22, 22, 22)

        callback(state)
    end)

    return B
end

